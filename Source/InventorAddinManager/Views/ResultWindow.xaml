<Window
	x:Class="InventorAddinManager.Views.ResultWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Width="720"
	Height="420"
	MinWidth="400"
	MinHeight="200"
	ShowInTaskbar="False"
	WindowStartupLocation="CenterOwner">
	<DockPanel Margin="12">
		<Button
			Width="80"
			Margin="0,12,0,0"
			HorizontalAlignment="Right"
			Content="OK"
			DockPanel.Dock="Bottom"
			IsCancel="True"
			IsDefault="True" />
		<TextBox
			x:Name="_resultText"
			FontFamily="Consolas"
			HorizontalScrollBarVisibility="Auto"
			IsReadOnly="True"
			TextWrapping="NoWrap"
			VerticalScrollBarVisibility="Auto" />
	</DockPanel>
</Window>
