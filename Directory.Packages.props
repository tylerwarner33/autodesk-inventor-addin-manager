<?xml version="1.0" encoding="utf-8"?>
<Project>
	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	</PropertyGroup>

	<ItemGroup>
		<!-- Version 17 forwards the stdole types to Microsoft.VisualStudio.Interop.dll. See the README, "How it works". -->
		<PackageVersion Include="stdole" Version="17.14.40260" />

		<!--
			A newer version than the 13.0.3 that Inventor ships.
			SampleCommands and the test commands use it to show that a command loads its own copy.
		-->
		<PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
	</ItemGroup>

	<!-- Tests only. -->
	<ItemGroup>
		<PackageVersion Include="xunit.v3" Version="4.0.3" />
	</ItemGroup>
</Project>
