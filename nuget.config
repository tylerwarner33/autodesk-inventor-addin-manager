<?xml version="1.0" encoding="utf-8"?>
<!--
	nuget.org only, on every machine. Central package management (Directory.Packages.props) stops a restore
	with more than one source (NU1507), and a source from a user's own NuGet.Config must not change this build.
-->
<configuration>
	<packageSources>
		<clear />
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
	</packageSources>
</configuration>
