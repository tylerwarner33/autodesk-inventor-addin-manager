<Project Sdk="Microsoft.NET.Sdk">

	<!--
		An ordinary class library. It has no reference to the manager and no .addin manifest.
		The manager loads it from this build output.
	-->
	<PropertyGroup>
		<TargetFramework>$(AddInTargetFramework)</TargetFramework>
		<OutputPath>$(ProjectDir)bin\$(Configuration)\$(AutodeskVersion)\</OutputPath>
		<RootNamespace>SampleCommands</RootNamespace>
		<AssemblyName>SampleCommands</AssemblyName>

		<!--
			The .NET setting for a plugin: package assemblies are copied to the output and listed in .deps.json.
			The manager resolves dependencies with that file, the same way that a host resolves a plugin's.
		-->
		<EnableDynamicLoading>true</EnableDynamicLoading>
	</PropertyGroup>

	<!-- A newer version than the 13.0.3 that Inventor ships, so PackageVersionReport can show which copy loads. -->
	<ItemGroup>
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
	</ItemGroup>

	<!-- Private=false: the manager gives the command Inventor's interop, so a copy in the output is not used. -->
	<ItemGroup>
		<Reference Include="Autodesk.Inventor.Interop">
			<HintPath>$(InventorInteropPath)</HintPath>
			<EmbedInteropTypes>false</EmbedInteropTypes>
			<Private>false</Private>
		</Reference>
	</ItemGroup>

</Project>
